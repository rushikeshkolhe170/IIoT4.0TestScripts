<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">
	<listeners>
		<listener class-name="Pages.Listener"></listener>
	</listeners>
  <test thread-count="5" name="ChromeTest">
	<parameter name="browserName" value="chrome" />
    <classes>
      <class name="LoginValidation.LoginPageValidation"/>
      <class name="LandingDashboard.CardsandValues"/>
      <class name="LandingDashboard.DepartmentLineDetails"/>
      <class name="LandingDashboard.ProgressBarTracking"/>
      <class name="LandingDashboard.LiveDashboard"/>
    </classes>
  </test> <!-- Test -->
  <test thread-count="5" name="FirefoxTest">
	<parameter name="browserName" value="firefox" />
    <classes>
      <class name="LoginValidation.LoginPageValidation"/>
      <class name="LandingDashboard.CardsandValues"/>
      <class name="LandingDashboard.DepartmentLineDetails"/>
      <class name="LandingDashboard.ProgressBarTracking"/>
      <class name="LandingDashboard.LiveDashboard"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
